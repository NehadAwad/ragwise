{
  "name": "ragwise",
  "version": "0.1.0",
  "description": "Smart document chunking with embeddings for RAG pipelines",
  "author": "Nehad Awad <nehadakash622@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NehadAwad/ragwise.git"
  },
  "bugs": {
    "url": "https://github.com/NehadAwad/ragwise/issues"
  },
  "homepage": "https://github.com/NehadAwad/ragwise#readme",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "pack:dry": "npm pack --dry-run"
  },
  "keywords": [
    "chunking",
    "rag",
    "embeddings",
    "markdown",
    "llm",
    "vector",
    "retrieval",
    "indexing"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "tiktoken": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "tiktoken": {
      "optional": true
    }
  }
}
